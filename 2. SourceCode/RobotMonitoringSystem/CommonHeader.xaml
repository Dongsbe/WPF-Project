<UserControl x:Class="RobotMonitoringSystem.CommonHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotMonitoringSystem"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="1200">

    <Border Background="#17395E"
            CornerRadius="10, 10, 0, 0"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border BorderBrush="#1A3250"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="20,0,0,0">
                    <Image Source="icon/robot-arm.png"
                           Width="50"
                           Height="50"
                           Margin="0,0,6,0"
                           Stretch="Uniform"/>
                    <TextBlock Text="산업용 로봇 작업 관제 시스템"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="25"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           x:Name="CurrentTimeText"
                           Text="2026. 10. 13. (화) 14:32:18"
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <Image Source="icon/user.png"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"/>
                    <TextBlock x:Name="UsernameText"
                               Text="비로그인"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Padding="5"/>
                </StackPanel>
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="─"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="14"
                            Click="Minimize_Click"/>

                    <Button Content="□"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="14"
                            Click="Maximize_Click"/>

                    <Button Content="×"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            FontSize="20"
                            Click="Close_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Border>
</UserControl>
