<Window x:Class="RobotMonitoringSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitoringSystem"
        mc:Ignorable="d"
        Title="LoginWindow"
        Width="1200"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    <Border CornerRadius="10"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:CommonHeader Grid.Row="0"/>

            <Grid Grid.Row="1"
                  Width="460"
                  Height="520"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.Resources>
                    <Style x:Key="LoginButton"
                           TargetType="Button">
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="Background" Value="#5B9FE8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Margin" Value="0, 10, 0, 12"/>
                        <Setter Property="Foreground" Value="White"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="7">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background" Value="#4A90E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background" Value="#3678B8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Border Width="440"
                        Height="460"
                        Margin="0, 55, 0, 0"
                        Padding="40, 75, 40, 35"
                        BorderBrush="#C8D8E8"
                        BorderThickness="2"
                        Background="#F4F8FC"
                        CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ID"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0, 0, 0, 6"/>
                        <Border Height="44"
                                Background="White"
                                BorderBrush="#C7D6E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0, 0, 0, 16">
                            <TextBox x:Name="UsernameInput"
                                     FontSize="15"
                                     Padding="12, 0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </Border>

                        <TextBlock Text="Password"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0, 0, 0, 6"/>
                        <Border Height="44"
                                Background="White"
                                BorderBrush="#C7D6E5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0, 0, 0, 16">
                            <PasswordBox x:Name="PasswordInput"
                                         FontSize="15"
                                         Padding="12, 0"
                                         PasswordChar="*"
                                         KeyDown="PasswordInput_KeyDown"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                        </Border>
                        <Button Style="{StaticResource LoginButton}"
                                Content="LOGIN"
                                Click="LoginButton_Click"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0">

                            <Button Content="아이디 찾기"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#64748B"
                                    Cursor="Hand"/>

                            <TextBlock Text="|"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>   

                            <Button Content="비밀번호 찾기"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#64748B"
                                    Cursor="Hand"/>

                            <TextBlock Text="|"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       Margin="8,0"/>

                            <Button Content="회원가입"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#4A90E2"
                                    Cursor="Hand"/> 
                        </StackPanel>
                    </StackPanel>
                </Border>


                <Border CornerRadius="55"
                        Background="#5B9FE8"
                        Width="110"
                        Height="110"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center">
                    <Image Source="/icon/user.png"
                           Width="80"
                           Height="80"/>
                </Border>
            </Grid>

        </Grid>
    </Border>

</Window>
