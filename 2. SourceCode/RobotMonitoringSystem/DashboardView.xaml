<UserControl x:Class="RobotMonitoringSystem.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RobotMonitoringSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Black">
    <!-- #F3F6FA -->
    <Grid Margin="6, 4">

        <Grid.Resources>
            <Style x:Key="BoardStyle"
                   TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 1행 1번 카드 -->
            <Border Grid.Column="0"
                    Style="{StaticResource BoardStyle}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Stretch="Uniform"
                             Margin="10">
                        <Border Width="50"
                                Height="50"
                                CornerRadius="25"
                                Background="#E8F3FF">
                            <Image Source="/icon/robot-arm.png"
                                   Width="40"
                                   Height="40"/>
                        </Border>
                    </Viewbox>

                    <Viewbox Grid.Column="1"
                             Stretch="Uniform">
                        <StackPanel Margin="0, 10, 10, 10">
                            <TextBlock Text="전체 로봇"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#1F3552"/>
                            <StackPanel VerticalAlignment="Bottom"
                                        Orientation="Horizontal">
                                <TextBlock Text="24"
                                           FontSize="30"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="대"
                                           FontSize="15"
                                           Margin="5, 0, 0, 4"
                                           VerticalAlignment="Bottom"
                                           Foreground="#52657D"/>
                            </StackPanel>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Border>
            
            <!-- 1행 2번 카드 -->
            <Border Grid.Column="1"
                    Style="{StaticResource BoardStyle}">
            </Border>
            
            <!-- 1행 3번 카드 -->
            <Border Grid.Column="2"
                    Style="{StaticResource BoardStyle}">
            </Border>
            
            <!-- 1행 4번 카드 -->
            <Border Grid.Column="3"
                    Style="{StaticResource BoardStyle}">
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 2행 1번 카드 -->
            <Border Grid.Column="0"
                    Style="{StaticResource BoardStyle}">
            </Border>

            <!-- 2행 2번 카드 -->
            <Border Grid.Column="1"
                    Style="{StaticResource BoardStyle}">
            </Border>

            <!-- 2행 3번 카드 -->
            <Border Grid.Column="2"
                    Style="{StaticResource BoardStyle}">
            </Border>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 3행 1번 카드 -->
            <Border Grid.Column="0"
                    Style="{StaticResource BoardStyle}">
            </Border>

            <!-- 3행 2번 카드 -->
            <Border Grid.Column="1"
                    Style="{StaticResource BoardStyle}">
            </Border>
        </Grid>
    </Grid>
</UserControl>
