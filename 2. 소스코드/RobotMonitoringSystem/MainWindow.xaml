<Window x:Class="RobotMonitoringSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotMonitoringSystem"
        mc:Ignorable="d"
        Title="산업용 로봇 작업 관제 시스템"
        Width="1200"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border CornerRadius="10"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:CommonHeader x:Name="MainHeader"
                                Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#153553"
                        BorderThickness="0"
                        CornerRadius="0,0,0,10">

                    <Border.Resources>
                        <Style x:Key="SideMenuStyle"
                               TargetType="RadioButton">
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="Width" Value="180"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="Transparent"/>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                            <ContentPresenter VerticalAlignment="Center"/>

                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background" Value="#24577F"/>
                                </Trigger>

                                <Trigger Property="IsChecked"
                                         Value="True">
                                    <Setter Property="Background" Value="#1677FF"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                        <Style x:Key="SideMenuIconStyle"
                               TargetType="Image">
                            <Setter Property="Width" Value="32"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Margin" Value="12, 0, 10, 0"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel VerticalAlignment="Top"
                                Margin="0,12,0,0">
                        <RadioButton GroupName="SideMenu"
                                 Style="{StaticResource SideMenuStyle}"
                                 IsChecked="True"
                                 Checked="DashboardView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/home.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="메인 대시보드"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SideMenu"
                                     Style="{StaticResource SideMenuStyle}"
                                     Checked="RobotManagementView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/robot-arm.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="로봇 관리"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SideMenu"
                                     Style="{StaticResource SideMenuStyle}"
                                     Checked="TaskManagementView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/list.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="작업 관리"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SideMenu"
                                     Style="{StaticResource SideMenuStyle}"
                                     Checked="TaskControlView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/monitoring.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="작업 관제"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SideMenu"
                                     Style="{StaticResource SideMenuStyle}"
                                     Checked="AlarmManagementView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/bell.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="알람 관리"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="SideMenu"
                                     Style="{StaticResource SideMenuStyle}"
                                     Checked="HistoryView_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/icon/history.png"
                                       Style="{StaticResource SideMenuIconStyle}"/>
                                <TextBlock Text="이력 조회"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="MainViewport"
                                Grid.Column="1">
                    <local:DashboardView/>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>